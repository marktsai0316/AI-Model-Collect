<mujoco model="simple_ball">
    <!-- 定義物理選項，例如重力 -->
    <option gravity="0 0 -9.81" />

    <!-- 定義視覺與材料資源 -->
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="cross" markrgb="1 1 1"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    </asset>

    <!-- 定義世界的物理主體 -->
    <worldbody>
        <!-- 光源 -->
        <light pos="0 0 3" dir="0 0 -1"/>

        <!-- 地面 (靜止不動的平麵) -->
        <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

        <!-- 一顆懸空的小球，帶有質量與碰撞屬性 -->
        <body name="ball" pos="0 0 1.5">
            <!-- 允許自由移動的關節（6個自由度：3個平移 + 3個旋轉） -->
            <freejoint name="ball_joint"/>
            
            <!-- 球體幾何與質量（由 density 自動計算） -->
            <geom name="ball_geom" type="sphere" size="0.2" rgba="0.8 0.2 0.2 1" density="1000"/>
        </body>
    </worldbody>
</mujoco>